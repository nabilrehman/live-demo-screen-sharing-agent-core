# LiveKit project (agent worker + join tokens)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live on Vertex AI (the brain: sees the shared screen as video, talks)
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GOOGLE_CLOUD_LOCATION=us-central1
# locally: `gcloud auth application-default login`; in LiveKit Cloud: GOOGLE_CREDENTIALS_JSON_B64 (base64 key file) as a secret

# Jev (the hands: picks the element for every click)
JEV_OPENROUTER_API_KEY=

# The product being demoed: start page + a logged-in browser state (Playwright storage_state JSON)
DEMO_START_URL=https://cloud.livekit.io/projects/<project-id>/overview
FAAN_STORAGE_STATE=state/dashboard_login.json        # or FAAN_STORAGE_STATE_B64 in the cloud
DEMO_PROJECT_URL=                                    # optional: delete Builder agents left by earlier demos at start

# Optional
BRAIN=gemini-live                                    # or grok: Grok Voice via LiveKit Inference (screen as text only)
# BLOCK_CLICKS=<regex>                               # labels never clicked; unset = the default list, set empty = off
AGENT_NAME=live-demo-agent
AVATAR_PROVIDER=anam
ANAM_API_KEY=
ANAM_AVATAR_ID=
LOG_URL=                                             # optional: upload each call's step log (see web/api/log.js)
LOG_SECRET=
